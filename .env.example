# Copy to .env and fill in. Never commit .env.
# --- Chroma Cloud (https://cloud.trychroma.com) ---
# When CHROMA_API_KEY is set, the pipeline uses Chroma Cloud.
# When empty, it falls back to local ChromaDB at VECTOR_DB_DIR.
CHROMA_API_KEY=""
CHROMA_TENANT=""
CHROMA_DATABASE=""

# --- Local vector DB (used when CHROMA_API_KEY is empty) ---
VECTOR_DB_DIR="./src/advanced_rag/vector_db"
RAG_COLLECTION="rag_collection"

# --- Models ---
OLLAMA_MODEL="llama3.2"
EMBEDDING_MODEL="nomic-ai/nomic-embed-text-v1.5"
RERANKER_MODEL="BAAI/bge-reranker-base"

# --- Retrieval tuning ---
RAG_TOP_K="4"
RAG_MIN_RERANK_SCORE="0.01"

# --- Docs to ingest ---
DOCS_DIR="./docs"

# --- Misc ---
HF_TOKEN=""
LANGSMITH_API_KEY=""
