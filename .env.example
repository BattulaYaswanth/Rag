# Copy to .env and fill in. Never commit .env.
# --- Chroma Cloud (https://cloud.trychroma.com) ---
# When CHROMA_API_KEY is set, the pipeline uses Chroma Cloud.
# When empty, it falls back to local ChromaDB at VECTOR_DB_DIR.
CHROMA_API_KEY=""
CHROMA_TENANT=""
CHROMA_DATABASE=""

# --- Local vector DB (used when CHROMA_API_KEY is empty) ---
VECTOR_DB_DIR="./src/advanced_rag/vector_db"
RAG_COLLECTION="rag_collection"

# --- Generation: Ollama for local dev, Groq for prod (LLM_PROVIDER picks) ---
LLM_PROVIDER="ollama"
OLLAMA_MODEL="llama3.2"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# --- Embeddings (shared vector space: ingest + retrieval use Voyage) ---
VOYAGE_API_KEY=""
VOYAGE_EMBED_MODEL="voyage-3"
# Rerank stays Cohere (text-based, needs no shared space).
COHERE_API_KEY=""
COHERE_RERANK_MODEL="rerank-english-v3.0"
# fastembed (local ONNX) is only for semantic-chunk boundaries, not the index.
FASTEMBED_MODEL="BAAI/bge-small-en-v1.5"

# --- Retrieval tuning ---
RAG_TOP_K="4"
RAG_MIN_RERANK_SCORE="0.01"

# --- Docs to ingest ---
DOCS_DIR="./docs"

# --- Misc ---
HF_TOKEN=""
LANGSMITH_API_KEY=""
